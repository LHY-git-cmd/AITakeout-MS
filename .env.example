# Copy to .env for local development only. Never commit .env or real secrets.

# Runtime / profile
SPRING_PROFILES_ACTIVE=dev
APP_ENV=development
LOG_LEVEL=INFO

# sky-server -> sky-agent
AGENT_BASE_URL=http://localhost:8000
JAVA_INTERNAL_BASE_URL=http://localhost:8080
# Must be the same random value (at least 32 characters) in sky-server and sky-agent.
# The Compose acceptance script compares hashes only and never prints this value.
AGENT_INTERNAL_SERVICE_TOKEN=replace-with-random-agent-service-token-at-least-32-chars
TOOL_CONFIRMATION_TIMEOUT_SECONDS=300
AI_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:9528,http://localhost:8081

# Compose acceptance defaults; these are identifiers/URLs, not secrets.
AGENT_ACCEPTANCE_PROJECT_NAME=sky-take-out
AGENT_ACCEPTANCE_DATA_PREFIX=agent-v1-acceptance-
AGENT_ACCEPTANCE_SERVER_URL=http://127.0.0.1:8080
AGENT_ACCEPTANCE_AGENT_URL=http://127.0.0.1:8000
AGENT_ACCEPTANCE_EMBEDDING_URL=http://127.0.0.1:8001
AGENT_ACCEPTANCE_QDRANT_URL=http://127.0.0.1:6333

# MySQL
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sky_take_out
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password
MYSQL_DATABASE=sky_take_out
MYSQL_USER=replace-with-database-user
MYSQL_PASSWORD=replace-with-database-password
MYSQL_ROOT_PASSWORD=replace-with-root-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password
REDIS_DATABASE=10

# JWT: each secret must be random and contain at least 32 characters.
JWT_ADMIN_SECRET=replace-with-random-admin-secret-at-least-32-chars
JWT_USER_SECRET=replace-with-random-user-secret-at-least-32-chars

# OpenAI-compatible LLM (shared names for Java and Agent)
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=replace-with-model-name
LLM_API_KEY=replace-with-api-key
LLM_ALLOWED_MODELS=replace-with-model-name
LLM_FALLBACK_MODEL=
LLM_REASONING_EFFORT=high
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=15
LLM_TOTAL_TIMEOUT_SECONDS=90
LLM_MAX_CONCURRENCY=4
LLM_MAX_QUEUE_SIZE=16
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_TEMPERATURE_MIN=0
LLM_TEMPERATURE_MAX=0.3
LLM_THINKING_ENABLED=false
AGENT_MAX_CONTEXT_CHARS=24000

# Agent / RAG
HOST=0.0.0.0
PORT=8000
TASK_STATE_DB=data/agent_tasks.sqlite3
KNOWLEDGE_STATE_DB=data/knowledge_tasks.sqlite3
KNOWLEDGE_SOURCE_PATH=data/knowledge_sources
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sky_knowledge_v2
RAG_ENABLED=true
RAG_TOP_K=8
RAG_SCORE_THRESHOLD=0.35

# Embedding client and service
EMBEDDING_BASE_URL=http://localhost:8001
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MODEL_PATH=./sky-embedding/models/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false
EMBEDDING_MAX_BATCH_SIZE=16

# Optional integrations; leave empty when the feature is unused.
ALIOSS_ENDPOINT=
ALIOSS_ACCESS_KEY_ID=
ALIOSS_ACCESS_KEY_SECRET=
ALIOSS_BUCKET_NAME=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
BAIDU_MAP_AK=
SHOP_ADDRESS=北京市海淀区上地十街10号

# Compose service ports/data; consumed when module three adds compose.yml.
SKY_SERVER_PORT=8080
SKY_AGENT_PORT=8000
SKY_EMBEDDING_PORT=8001
SKY_SERVER_IMAGE=sky-server:module2
SKY_AGENT_IMAGE=sky-agent:module2
SKY_EMBEDDING_IMAGE=sky-embedding:module2
MYSQL_PORT=13306
REDIS_EXPOSED_PORT=6379
QDRANT_HTTP_PORT=6333
# Keep the model outside the image. Relative paths are resolved from compose.yml.
BGE_MODEL_HOST_PATH=./sky-embedding/models/bge-m3

# Named volumes. Change only when intentionally selecting another data set.
MYSQL_VOLUME_NAME=sky-take-out-mysql-data
REDIS_VOLUME_NAME=sky-take-out-redis-data
QDRANT_VOLUME_NAME=sky-take-out-qdrant-data
AGENT_VOLUME_NAME=sky-take-out-agent-data
SERVER_VOLUME_NAME=sky-take-out-server-data

# Optional observability profile
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

# Runtime controls
SHUTDOWN_TIMEOUT=30s
ORDER_TASK_BATCH_SIZE=200

# External infrastructure mode (used with compose.external.yml; leave unset for local mode)
# DB_HOST=database.example.internal
# REDIS_HOST=redis.example.internal
# QDRANT_URL=http://qdrant.example.internal:6333
EXTERNAL_EMBEDDING_BASE_URL=
EXTERNAL_AGENT_BASE_URL=
