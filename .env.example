# 应用环境 (development, test, production)
APP_ENV=development
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Agent 任务状态数据库文件路径
TASK_STATE_DB=data/agent_tasks.sqlite3
# 知识库任务状态数据库文件路径
KNOWLEDGE_STATE_DB=data/knowledge_tasks.sqlite3
# 知识库源文件存储路径
KNOWLEDGE_SOURCE_PATH=data/knowledge_sources
# 向量存储类型 (例如: qdrant)
VECTOR_STORE=qdrant
# Qdrant 服务的 URL
QDRANT_URL=http://localhost:6333
# Qdrant 集合名称
QDRANT_COLLECTION=sky_knowledge_v2
# Embedding 服务的基础 URL
EMBEDDING_BASE_URL=http://localhost:8001
# Embedding 模型名称
EMBEDDING_MODEL=BAAI/bge-m3
# Embedding 向量维度
EMBEDDING_DIMENSION=1024
# Embedding 批处理大小
EMBEDDING_BATCH_SIZE=16
# Agent 上下文最大字符数
AGENT_MAX_CONTEXT_CHARS=24000

# OpenAI-compatible LLM configuration. Never commit a real key.
# LLM 服务提供商 (例如: deepseek, openai)
LLM_PROVIDER=deepseek
# LLM 服务的 API 基础 URL
LLM_BASE_URL=https://api.deepseek.com
# 默认使用的 LLM 模型名称
LLM_MODEL=replace-with-model-name
# LLM 服务的 API 密钥
LLM_API_KEY=replace-with-api-key
# 备用 LLM 模型名称
LLM_FALLBACK_MODEL=
# 允许使用的 LLM 模型列表，逗号分隔
LLM_ALLOWED_MODELS=replace-with-model-name
# LLM 请求的总超时时间（秒）
LLM_TOTAL_TIMEOUT_SECONDS=90
# LLM 请求的连接超时时间（秒）
LLM_CONNECT_TIMEOUT_SECONDS=5
# LLM 请求收到第一个 token 的超时时间（秒）
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=15
# LLM 请求的最大并发数
LLM_MAX_CONCURRENCY=4
# LLM 请求的最大队列大小
LLM_MAX_QUEUE_SIZE=16
# LLM 请求的最大重试次数
LLM_MAX_RETRIES=2
# LLM 请求重试的基础延迟时间（秒）
LLM_RETRY_BASE_DELAY_SECONDS=0.5
# Provider pricing, in currency units per million tokens. Zero disables cost estimates.
# 每百万输入 token 的成本
LLM_INPUT_COST_PER_MILLION=0
# 每百万输出 token 的成本
LLM_OUTPUT_COST_PER_MILLION=0
# LLM 温度参数的最小值
LLM_TEMPERATURE_MIN=0
# LLM 温度参数的最大值
LLM_TEMPERATURE_MAX=0.3
# 是否启用 LLM 的思考过程（中间步骤）
LLM_THINKING_ENABLED=false