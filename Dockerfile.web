# 同时构建管理端与用户端，并使用一个Nginx容器提供两个独立站点。
FROM node:22-alpine AS user-build
WORKDIR /workspace
COPY frontend/project-sky-user-web/package*.json ./
RUN npm ci
COPY frontend/project-sky-user-web/ ./
RUN npm run build

FROM node:22-alpine AS admin-build
WORKDIR /workspace
COPY frontend/project-sky-admin-vue-ts/package.json frontend/project-sky-admin-vue-ts/yarn.lock ./
RUN yarn install --frozen-lockfile --non-interactive
COPY frontend/project-sky-admin-vue-ts/ ./
RUN yarn build

FROM nginx:1.28-alpine
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=admin-build /workspace/dist /usr/share/nginx/html/admin
COPY --from=user-build /workspace/dist /usr/share/nginx/html/user
EXPOSE 80 8081
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -q --spider http://127.0.0.1/ && wget -q --spider http://127.0.0.1:8081/ || exit 1
